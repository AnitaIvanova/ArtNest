@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
    string heroBg = Model.Artworks.Count > 0 ? Model.Artworks[0].ImageUrl : "";
}

<section class="hero-section">
    @if (!string.IsNullOrEmpty(heroBg))
    {
        <div class="hero-background" style="background-image: url('@heroBg');"></div>
    }
    else
    {
        <div class="hero-background hero-background-fallback"></div>
    }

    <div class="hero-content">
        <h2>
            Discover, remember, and cherish<br />the art that moves you.
        </h2>

        <p class="hero-text">
            A personal space to track museum visits, save artworks, and reflect on your experiences.
        </p>

        <div class="search-wrapper">
            <form method="get" action="/Explore">
                <div class="search-bar">
                    <span class="search-icon">⌕</span>
                    <input type="text" name="SearchQuery"
                           placeholder="Search artworks, artists, or museums…" />
                </div>
            </form>
        </div>

        <div class="hero-links">
            <a href="/Explore">Explore All</a>
            <span>•</span>
            <a href="/Wishlist">My Wishlist</a>
            <span>•</span>
            <a href="/Journal">My Journal</a>
        </div>
    </div>
</section>

<section class="featured-section">
    <div class="container">
        <h3>Featured Artworks</h3>

        @if (Model.Artworks.Count == 0)
        {
            <p class="page-subtitle">No artworks available yet. Check back soon!</p>
        }
        else
        {
            <div class="artwork-grid">
                @foreach (var artwork in Model.Artworks)
                {
                    <div class="artwork-card">
                        <div class="artwork-image-wrapper">
                            <img src="@artwork.ImageUrl" alt="@artwork.Title" class="artwork-image" />
                        </div>

                        <div class="artwork-card-body">
                            <h4>@artwork.Title</h4>
                            <p class="artist-name">@artwork.Artist</p>
                            <p class="museum-name">@artwork.Museum</p>

                            <form method="post" asp-page-handler="Save">
                                <input type="hidden" name="artworkId" value="@artwork.Id" />
                                <button class="save-button" type="submit">♡ Save</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

<section class="how-section">
    <div class="container">
        <div class="how-grid">
            <div class="how-card">
                <div class="icon-circle">◉</div>
                <h4>Discover</h4>
                <p>Search and explore artworks by artist, museum, or city.</p>
            </div>

            <div class="how-card">
                <div class="icon-circle">✦</div>
                <h4>Save</h4>
                <p>Create a personal wishlist of artworks you want to see.</p>
            </div>

            <div class="how-card">
                <div class="icon-circle">✎</div>
                <h4>Reflect</h4>
                <p>Write reflections and track your museum experiences.</p>
            </div>
        </div>
    </div>
</section>

<section class="cta-section">
    <div class="cta-content">
        <h3>
            Turn museum visits into lasting<br />personal art memories.
        </h3>
        <a href="/Register" class="cta-button">Start Your Collection</a>
    </div>
</section>
