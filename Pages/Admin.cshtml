@page
@model ARTNEST.Pages.AdminModel
@{
    ViewData["Title"] = "Add Artwork";
}

<section class="page-section">
    <div class="container wishlist-container">

        <div class="wishlist-header">
            <h1 class="page-title">Add Artwork</h1>
            <p class="page-subtitle">Add a new artwork to the collection</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="message-box @(Model.MessageIsSuccess ? "message-success" : "")">@Model.Message</div>
        }

        <form method="post" class="admin-form">
            <div class="form-group">
                <label>Title</label>
                <input type="text" asp-for="Title" />
            </div>
            <div class="form-group">
                <label>Artist</label>
                <input type="text" asp-for="Artist" />
            </div>
            <div class="form-group">
                <label>Museum</label>
                <input type="text" asp-for="Museum" />
            </div>
            <div class="form-group">
                <label>Image URL</label>
                <input type="text" asp-for="ImageUrl" />
            </div>
            <div class="form-group">
                <label>Description</label>
                <textarea asp-for="Description" rows="4"></textarea>
            </div>
            <div class="form-group">
                <label>Year</label>
                <input type="number" asp-for="Year" />
            </div>
            <button type="submit" class="cta-button">Add Artwork</button>
        </form>

    </div>
</section>