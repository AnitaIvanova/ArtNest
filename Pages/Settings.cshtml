@page
@model ARTNEST.Pages.SettingsModel
@{
    ViewData["Title"] = "Settings";
}

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">

<style>
    :root {
        --bg:        #EAE5D8;
        --surface:   #F2EDE3;
        --border:    rgba(107, 79, 58, 0.12);
        --brown:     #6B4F3A;
        --dark:      #2F2A26;
        --rust:      #8B4513;
        --sage:      #7D8F7A;
        --serif:     'Cormorant Garamond', serif;
        --sans:      'Jost', sans-serif;
    }

    body {
        background-color: var(--bg);
        font-family: var(--sans);
        color: var(--dark);
    }

    .settings-page {
        max-width: 760px;
        margin: 0 auto;
        padding: 56px 32px 80px;
    }

    .settings-page h1 {
        font-family: var(--serif);
        font-size: 3rem;
        font-weight: 400;
        letter-spacing: -0.5px;
        color: var(--dark);
        margin: 0 0 6px;
    }

    .settings-page .subtitle {
        font-size: 0.875rem;
        font-weight: 300;
        color: var(--brown);
        opacity: 0.75;
        margin: 0 0 52px;
        letter-spacing: 0.02em;
    }

    .section-label {
        font-family: var(--serif);
        font-size: 1.35rem;
        font-weight: 400;
        color: var(--brown);
        margin: 0 0 14px;
        letter-spacing: 0.01em;
    }

    .settings-section {
        margin-bottom: 44px;
    }

    .settings-card {
        background: var(--surface);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 1px 4px rgba(47, 42, 38, 0.06);
    }

    .settings-row {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 17px 22px;
        color: var(--brown);
        font-size: 0.9rem;
        font-weight: 400;
        letter-spacing: 0.02em;
        text-decoration: none;
        border: none;
        background: transparent;
        width: 100%;
        cursor: pointer;
        transition: background 0.18s ease, padding-left 0.18s ease;
        border-bottom: 1px solid var(--border);
    }

    .settings-row:last-child {
        border-bottom: none;
    }

    .settings-row:hover {
        background: rgba(107, 79, 58, 0.06);
        padding-left: 26px;
    }

    .settings-row svg,
    .settings-row .row-icon {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
        opacity: 0.75;
    }

    .settings-row .row-chevron {
        margin-left: auto;
        opacity: 0.3;
        font-size: 1rem;
    }

    .settings-row.destructive {
        color: var(--rust);
    }

    /* ── Account form ── */
    .account-form {
        padding: 24px 22px;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-group label {
        display: block;
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--brown);
        opacity: 0.7;
        margin-bottom: 7px;
    }

    .form-group input {
        width: 100%;
        padding: 11px 14px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: rgba(255,255,255,0.45);
        font-family: var(--sans);
        font-size: 0.875rem;
        color: var(--dark);
        outline: none;
        transition: border-color 0.18s, box-shadow 0.18s;
        box-sizing: border-box;
    }

    .form-group input:focus {
        border-color: rgba(107, 79, 58, 0.4);
        box-shadow: 0 0 0 3px rgba(107, 79, 58, 0.08);
    }

    .btn-save {
        margin-top: 8px;
        padding: 11px 22px;
        background: var(--brown);
        color: #fff;
        border: none;
        border-radius: 8px;
        font-family: var(--sans);
        font-size: 0.875rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        cursor: pointer;
        transition: background 0.18s, transform 0.12s;
    }

    .btn-save:hover {
        background: var(--dark);
        transform: translateY(-1px);
    }

    .card-divider {
        height: 1px;
        background: var(--border);
        margin: 0;
    }

    .info-card {
        background: var(--surface);
        border-radius: 12px;
        padding: 24px 22px;
        border-left: 3px solid var(--sage);
        box-shadow: 0 1px 4px rgba(47, 42, 38, 0.06);
        margin-top: 48px;
    }

    .info-card h3 {
        font-family: var(--serif);
        font-size: 1.2rem;
        font-weight: 400;
        color: var(--brown);
        margin: 0 0 6px;
    }

    .info-card .info-sub {
        font-size: 0.8rem;
        font-weight: 300;
        color: var(--brown);
        opacity: 0.65;
        margin: 0 0 18px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px 32px;
    }

    .info-item {
        font-size: 0.85rem;
        color: var(--brown);
    }

    .info-item strong {
        font-weight: 500;
        display: block;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        opacity: 0.55;
        margin-bottom: 2px;
    }

    .flash {
        padding: 14px 18px;
        border-radius: 10px;
        font-size: 0.875rem;
        margin-bottom: 28px;
        color: var(--brown);
    }
    .flash-success {
        background: rgba(125, 143, 122, 0.15);
        border: 1px solid rgba(125, 143, 122, 0.3);
    }
    .flash-error {
        background: rgba(200, 60, 43, 0.08);
        border: 1px solid rgba(200, 60, 43, 0.25);
        color: #8B2500;
    }
</style>

<div class="settings-page">

    <h1>Settings</h1>
    <p class="subtitle">Manage your account and preferences</p>

    @{ var flashClass = Model.MessageIsSuccess ? "flash-success" : "flash-error"; }
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="flash @flashClass">@Model.Message</div>
    }

    <div class="settings-section">
        <p class="section-label">Account</p>
        <div class="settings-card">
            <form method="post" class="account-form">
                <div class="form-group">
                    <label asp-for="Name">Name</label>
                    <input asp-for="Name" placeholder="Your name" />
                </div>
                <div class="form-group">
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" placeholder="your@email.com" />
                </div>
                <div class="form-group">
                    <label asp-for="NewPassword">New Password</label>
                    <input asp-for="NewPassword" type="password" placeholder="Leave blank to keep current" />
                </div>
                <div class="form-group">
                    <label asp-for="ConfirmPassword">Confirm New Password</label>
                    <input asp-for="ConfirmPassword" type="password" placeholder="Repeat new password" />
                </div>
                <button type="submit" class="btn-save">Save Changes</button>
            </form>

            <div class="card-divider"></div>

            <a asp-page="/Logout" class="settings-row destructive">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
                <span>Log Out</span>
                <span class="row-chevron">›</span>
            </a>
        </div>
    </div>

    <div class="settings-section">
        <p class="section-label">Information</p>
        <div class="settings-card">
            <a href="/Privacy" class="settings-row">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
                </svg>
                <span>Privacy Policy</span>
                <span class="row-chevron">›</span>
            </a>
            <a href="/Privacy" class="settings-row">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
                </svg>
                <span>Contact</span>
                <span class="row-chevron">›</span>
            </a>
        </div>
    </div>

    <div class="settings-section">
        <p class="section-label">Legal</p>
        <div class="settings-card">
            <a href="/Privacy" class="settings-row">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
                <span>Privacy Policy</span>
                <span class="row-chevron">›</span>
            </a>
            <a href="/Privacy" class="settings-row">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
                </svg>
                <span>Terms of Service</span>
                <span class="row-chevron">›</span>
            </a>
        </div>
    </div>

    <div class="info-card">
        <h3>Account Information</h3>
        <p class="info-sub">Your personal art collection at a glance</p>
        <div class="info-grid">
            <div class="info-item">
                <strong>Email</strong>
                @Model.Email
            </div>
            <div class="info-item">
                <strong>Member since</strong>
                @Model.MemberSince
            </div>
            <div class="info-item">
                <strong>Saved artworks</strong>
                @Model.SavedArtworksCount
            </div>
            <div class="info-item">
                <strong>Visited artworks</strong>
                @Model.VisitedArtworksCount
            </div>
        </div>
    </div>

</div>
